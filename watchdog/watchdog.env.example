# Settings for watchdog/watchdog.mjs, read by pixa-node-watch.service. Every line is optional: an unchanged clone
# of this repository needs none of them to be watched, and one of the first two to be told.
# Keep your copy outside the repository (/etc/pixa-node-watch.env, mode 600): a webhook address is a secret.

# Where alerts go: a webhook, a command, or both.
#NODE_WATCH_WEBHOOK=https://hooks.example.com/services/...
#NODE_WATCH_COMMAND=/usr/local/bin/pixa-node-alert

# What alerts call this node. The hostname if unset.
#NODE_WATCH_NAME=api.example.com

# The address apps use, so the router is asked one small Hivemind question each run. Unset, that isn't asked.
#NODE_WATCH_API=https://api.example.com

# Another node of the same chain, asked only when this one's head is three minutes old, to tell a node that has
# lost the chain from a chain that has stopped for everyone. Unset, an old head is never acted on.
# https://api.pixagram.com, or https://api.pixtopia.net if this node is api.pixagram.com.
#NODE_WATCH_OTHER=https://api.pixagram.com

# Count the TLS proxy as part of the stack too.
#NODE_WATCH_SERVICES=pixagram,pixagram_haf,hivemind_sync,hivemind,jussi,ssl-proxy

# Allow the whole stack to be recreated when restarting the one part didn't help. Off unless set: it takes the
# public API away for as long as the stack takes to come back.
#NODE_WATCH_RECREATE=1
